# ==================== General Settings ====================
PORT=3000
NODE_ENV=development
MOCK_MODE=false

# ==================== Database (Supabase PostgreSQL) ====================
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ==================== Location (กาดกองต้า ลำปาง) ====================
DEFAULT_LAT=18.2816
DEFAULT_LON=99.5082

# ==================== LINE OA Integration (Messaging API) ====================
LINE_CHANNEL_ACCESS_TOKEN=your_line_oa_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_oa_channel_secret_here

# ==================== LINE Login (OAuth 2.0 v2.1) ====================
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret_here
LINE_LOGIN_CALLBACK_URL=http://localhost:5173/settings

# ==================== Frontend URL ====================
FRONTEND_URL=http://localhost:5173

# ==================== Session Settings ====================
SESSION_SECRET=your_secure_session_secret_key_here_change_in_production
SESSION_MAX_AGE=604800000

# ==================== OpenWeatherMap API ====================
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ==================== Camera/People Count API ====================
CAMERA_API_URL=http://localhost:8000
CAMERA_API_KEY=your_camera_api_key_here

# ==================== NVR Camera Credentials ====================
# ห้าม hardcode ค่าเหล่านี้ในโค้ด — ใช้ environment variables เท่านั้น
NVR_HOST_A=               # IP ของ NVR หลัก เช่น 10.0.10.3
NVR_HOST_B=               # IP ของ NVR สำรอง เช่น 10.0.10.4
NVR_USER=                 # Username ของ NVR
NVR_PASS=                 # Password ของ NVR
WEBRTC_BASE_URL=          # URL ของ WebRTC proxy เช่น https://host:8085

# ==================== AI Service ====================
AI_API_KEY=your_ai_service_api_key_here_must_match_config_yaml

# ==================== Officer Token (เจ้าหน้าที่) ====================
OFFICER_TOKENS=token1,token2,token3

# ==================== Rate Limiting ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== Polling Settings ====================
POLLING_INTERVAL=60000

# ==================== Daily Report Settings ====================
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=0

# ==================== Testing ====================
# Leave empty for production; tests set this to forlp_test automatically
PGSCHEMA=
