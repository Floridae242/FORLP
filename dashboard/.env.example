# Lampang Smart City IOC (iocpiramid.com) — server-side only, never exposed to the browser
IOC_BASE_URL=https://iocpiramid.com
IOC_USERNAME=your_ioc_username
IOC_PASSWORD=your_ioc_password
# keyword used to select this site's cameras from the IOC device list
IOC_SITE_KEYWORD=กาดกองต้า

# FORLP backend (people-count / weather / zones)
NEXT_PUBLIC_API_URL=https://forlp.onrender.com
